---
// A commit-graph lane down the left of the page it's placed in, which must be positioned. Every element marked
// data-commit is a commit on it, in page order: "main", "branch" (on a side lane that leaves the last main commit),
// "merge" (back on main, joining the side lane) and finally "head". Commits light up as they scroll into view, and
// stay lit. Decorative, so hidden from screen readers.
---

<svg class="thread" aria-hidden="true"></svg>

<script>
	const NS = 'http://www.w3.org/2000/svg';
	// Sidereal's own lane colors, as in the sky.
	const MAIN = '#65a7fa';
	const SIDE = '#e78a45';
	/** How far the side lane sits from main, and how long a lane change takes, in pixels. */
	const STEP = 16;
	const BEND = 26;

	type Point = { x: number; y: number };
	type Commit = Point & { el: HTMLElement; kind: string; dot: SVGCircleElement };
	type Edge = { to: number; path: SVGPathElement };

	const svg = document.querySelector<SVGSVGElement>('svg.thread')!;
	const host = svg.parentElement!;
	const reduced = matchMedia('(prefers-reduced-motion: reduce)');
	let commits: Commit[] = [];
	let edges: Edge[] = [];
	/** The newest commit lit so far. */
	let lit = -1;

	function node<K extends keyof SVGElementTagNameMap>(name: K, attrs: Record<string, string | number>) {
		const e = document.createElementNS(NS, name);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		return e;
	}

	/** Straight down, or across to the other lane: just after leaving for a branch, just before arriving for a merge. */
	function route(a: Point, b: Point, merging: boolean) {
		if (a.x === b.x) return `M${a.x} ${a.y}V${b.y}`;
		if (merging) return `M${a.x} ${a.y}V${b.y - BEND}C${a.x} ${b.y - BEND * 0.4} ${b.x} ${b.y - BEND * 0.6} ${b.x} ${b.y}`;
		return `M${a.x} ${a.y}C${a.x} ${a.y + BEND * 0.6} ${b.x} ${a.y + BEND * 0.4} ${b.x} ${a.y + BEND}V${b.y}`;
	}

	function layout() {
		const box = host.getBoundingClientRect();
		const els = [...host.querySelectorAll<HTMLElement>('[data-commit]')];
		if (!els.length) return;
		svg.setAttribute('width', String(box.width));
		svg.setAttribute('height', String(box.height));
		svg.replaceChildren();
		// Just left of the text, in the margin the page leaves for it.
		const x = els[0].getBoundingClientRect().left - box.left - 30;
		commits = els.map((el) => {
			const r = el.getBoundingClientRect();
			const kind = el.dataset.commit!;
			return { el, kind, x: kind === 'branch' ? x + STEP : x, y: r.top - box.top + r.height / 2 } as Commit;
		});

		// Older history fades in from above the first commit.
		const top = { x, y: commits[0].y - 140 };
		const fade = node('linearGradient', { id: 'thread-fade', gradientUnits: 'userSpaceOnUse', x1: x, y1: top.y, x2: x, y2: commits[0].y });
		fade.append(node('stop', { offset: 0, 'stop-color': MAIN, 'stop-opacity': 0 }), node('stop', { offset: 1, 'stop-color': MAIN }));
		const defs = node('defs', {});
		defs.append(fade);
		const track = node('g', { class: 'track' });
		const lanes = node('g', { class: 'lanes' });
		const dots = node('g', {});
		svg.append(defs, track, lanes, dots);

		edges = [];
		const join = (a: Point, b: Commit, to: number, color: string, merging = false) => {
			const d = route(a, b, merging);
			const stroke = a === top ? 'url(#thread-fade)' : color;
			track.append(node('path', { d, stroke }));
			const path = node('path', { d, stroke, pathLength: 1 });
			lanes.append(path);
			edges.push({ to, path });
		};
		let main: Point = top;
		let side: Commit | null = null;
		commits.forEach((c, i) => {
			if (c.kind === 'branch') {
				join(main, c, i, SIDE);
				side = c;
			} else {
				join(main, c, i, MAIN);
				if (c.kind === 'merge' && side) join(side, c, i, SIDE, true);
				if (c.kind === 'merge') side = null;
				main = c;
			}
			const color = c.kind === 'branch' ? SIDE : MAIN;
			c.dot = node('circle', { cx: c.x, cy: c.y, r: c.kind === 'head' ? 6 : 4.5, class: c.kind, style: `--c: ${color}` });
			dots.append(c.dot);
		});
		// Rebuilt from scratch, so what was lit comes back lit without playing again.
		light(0, lit, false);
	}

	function light(from: number, to: number, animate: boolean) {
		for (let i = from; i <= to; i++) {
			// Several at once, after a fast scroll, light one after another.
			const delay = animate ? (i - from) * 0.3 : 0;
			for (const e of edges) {
				if (e.to !== i) continue;
				e.path.style.transitionDelay = `${delay}s`;
				e.path.classList.add('on');
			}
			const c = commits[i];
			c.dot.style.transitionDelay = `${animate ? delay + 0.5 : 0}s`;
			c.dot.classList.add('on');
			if (animate) {
				const ring = node('circle', { cx: c.x, cy: c.y, r: 5, class: 'ring', style: `--c: ${c.dot.style.getPropertyValue('--c')}` });
				ring.style.animationDelay = `${delay + 0.5}s`;
				c.dot.before(ring);
			}
		}
	}

	/** Lights every commit that has scrolled up past the lower part of the window, and all of them at the bottom. */
	function refresh() {
		const line = innerHeight * 0.72;
		let n = -1;
		commits.forEach((c, i) => {
			if (c.el.getBoundingClientRect().top < line) n = i;
		});
		if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) n = commits.length - 1;
		if (n <= lit) return;
		const from = lit + 1;
		lit = n;
		light(from, n, !reduced.matches);
	}

	let queued = false;
	addEventListener(
		'scroll',
		() => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				refresh();
			});
		},
		{ passive: true },
	);
	new ResizeObserver(() => {
		layout();
		refresh();
	}).observe(host);
</script>

<style>
	.thread {
		position: absolute;
		top: 0;
		left: 0;
		overflow: visible;
		pointer-events: none;
	}
	.thread :global(path) {
		fill: none;
		stroke-width: 2;
		stroke-linecap: round;
	}
	/* The road ahead, faint and dotted. */
	.thread :global(.track path) {
		opacity: 0.25;
		stroke-dasharray: 1 5;
	}
	.thread :global(.lanes path) {
		stroke-dasharray: 1 1;
		stroke-dashoffset: 1;
		transition: stroke-dashoffset 0.7s cubic-bezier(0.2, 0, 0, 1);
	}
	.thread :global(.lanes path.on) {
		stroke-dashoffset: 0;
	}
	.thread :global(circle) {
		fill: var(--bg);
		stroke: var(--c);
		stroke-width: 1.5;
		opacity: 0.5;
		transition:
			fill 0.4s,
			opacity 0.4s;
	}
	.thread :global(circle.on) {
		fill: var(--c);
		opacity: 1;
	}
	.thread :global(circle.head.on) {
		fill: #fff;
		stroke-width: 2.5;
		filter: drop-shadow(0 0 6px var(--c));
	}
	.thread :global(circle.ring) {
		fill: none;
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
		animation: ping 0.9s ease-out forwards;
	}
	@keyframes ping {
		from {
			opacity: 0.8;
			transform: scale(1);
		}
		to {
			opacity: 0;
			transform: scale(3.5);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.thread :global(*) {
			transition: none;
		}
	}
</style>
