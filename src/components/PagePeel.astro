---
// Following a link marked data-peel curls this page away from the bottom-right corner, revealing the linked site,
// then navigates there. Browsers don't animate between two sites, so the site is loaded into a full-window frame
// when the pointer reaches the link and stands in for the real page until the navigation lands. A site that refuses
// to be framed is marked data-peel-frame="false", and the peel reveals black and white smoke instead.
---

<script>
	const NS = 'http://www.w3.org/2000/svg';
	const DURATION = 900;

	type Point = [number, number];

	let frame: HTMLElement | undefined;
	let framed: string | undefined;
	let overlay: SVGSVGElement | undefined;
	let smokeField: HTMLElement | undefined;

	const peelLink = (target: EventTarget | null) =>
		target instanceof Element ? target.closest<HTMLAnchorElement>('a[data-peel]') : null;

	const CORNERS = `
		attribute vec2 corner;

		void main() {
			gl_Position = vec4(corner, 0.0, 1.0);
		}
	`;

	// Noise whose coordinates are pushed around by more noise, which curls it like smoke.
	const SMOKE = `
		precision highp float;
		uniform vec2 size;
		uniform float time;

		float hash(vec2 p) {
			return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
		}

		float noise(vec2 p) {
			vec2 i = floor(p);
			vec2 f = fract(p);
			vec2 u = f * f * (3.0 - 2.0 * f);
			float bottom = mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x);
			float top = mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x);
			return mix(bottom, top, u.y);
		}

		float fbm(vec2 p) {
			float sum = 0.0;
			float amplitude = 0.5;
			for (int i = 0; i < 4; i++) {
				sum += amplitude * noise(p);
				p = p * 2.0 + vec2(1.7, 9.2);
				amplitude *= 0.5;
			}
			return sum;
		}

		void main() {
			// Drifting as it curls. At this scale the window always holds some of both black and white.
			vec2 p = gl_FragCoord.xy / size.y * 1.8 + vec2(0.12, 0.04) * time;
			float t = time * 0.22;
			vec2 q = vec2(fbm(p + vec2(0.0, t)), fbm(p + vec2(5.2, 1.3) - t));
			vec2 r = vec2(fbm(p + 1.5 * q + vec2(1.7, 9.2) + 0.7 * t), fbm(p + 1.5 * q + vec2(8.3, 2.8) - 0.6 * t));
			// The smoke's values bunch around 0.45; a soft ramp across them gives black, white and fog between.
			gl_FragColor = vec4(vec3(smoothstep(0.34, 0.56, fbm(p + 1.5 * r))), 1.0);
		}
	`;

	/**
	 * Black and white smoke curling across the window, for a site the peel can't show: black and white suit it
	 * whichever of its themes it loads in. It moves only while the peel shows it.
	 */
	function smoke() {
		const field = document.createElement('div');
		const canvas = document.createElement('canvas');
		// Smoke has no fine detail to lose, so it's drawn at half size and stretched.
		canvas.width = Math.ceil(innerWidth / 2);
		canvas.height = Math.ceil(innerHeight / 2);
		field.append(canvas);
		const gl = canvas.getContext('webgl', { alpha: false, antialias: false, depth: false });
		if (!gl) return field;
		const program = gl.createProgram()!;
		for (const [type, source] of [
			[gl.VERTEX_SHADER, CORNERS],
			[gl.FRAGMENT_SHADER, SMOKE],
		] as const) {
			const shader = gl.createShader(type)!;
			gl.shaderSource(shader, source);
			gl.compileShader(shader);
			gl.attachShader(program, shader);
		}
		gl.bindAttribLocation(program, 0, 'corner');
		gl.linkProgram(program);
		gl.useProgram(program);
		gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
		// One triangle big enough to cover the canvas.
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		gl.enableVertexAttribArray(0);
		gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
		gl.uniform2f(gl.getUniformLocation(program, 'size'), canvas.width, canvas.height);
		const time = gl.getUniformLocation(program, 'time');
		// Starts somewhere different on each visit.
		const start = performance.now() - Math.random() * 20_000;
		const draw = (now: number) => {
			gl.uniform1f(time, (now - start) / 1000);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
		};
		const play = (now: number) => {
			if (field.style.visibility !== 'visible') return;
			draw(now);
			requestAnimationFrame(play);
		};
		draw(performance.now());
		field.addEventListener('peel', () => requestAnimationFrame(play));
		return field;
	}

	function prepare(link: HTMLAnchorElement) {
		if (frame && framed === link.href) return frame;
		frame?.remove();
		framed = link.href;
		if (link.dataset.peelFrame === 'false') {
			// Shared by every such link, as browsers allow a page only a few of the graphics contexts it draws with.
			frame = smokeField ??= smoke();
		} else {
			const site = document.createElement('iframe');
			// Lets the site run as usual but not navigate this window. Set before src, which is when it takes effect.
			site.sandbox.add('allow-scripts', 'allow-same-origin');
			site.src = link.href;
			site.title = link.textContent?.trim() ?? '';
			site.tabIndex = -1;
			frame = site;
		}
		frame.classList.add('peel-frame');
		frame.setAttribute('aria-hidden', 'true');
		frame.style.background = link.dataset.peel ?? '';
		document.body.append(frame);
		return frame;
	}

	function el<K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number>, parent?: Element) {
		const node = document.createElementNS(NS, tag);
		for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, String(value));
		parent?.append(node);
		return node;
	}

	function gradient(id: string, stops: [number, string][], parent: Element) {
		const node = el('linearGradient', { id, gradientUnits: 'userSpaceOnUse' }, parent);
		for (const [offset, color] of stops) el('stop', { offset, style: `stop-color: ${color}` }, node);
		return node;
	}

	const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
	const points = (list: Point[]) => list.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');

	function peel(link: HTMLAnchorElement) {
		const page = prepare(link);
		const w = innerWidth;
		const h = innerHeight;
		const length = Math.hypot(w, h);
		// The fold runs across the window's diagonal and sweeps from the bottom-right corner to the top-left one.
		const n: Point = [w / length, h / length];
		const along = ([x, y]: Point) => x * n[0] + y * n[1];
		const corners: Point[] = [[0, 0], [w, 0], [w, h], [0, h]];

		/** The part of the window past the fold, where the page has lifted away. */
		function revealed(fold: number) {
			const out: Point[] = [];
			corners.forEach((p, i) => {
				const q = corners[(i + 1) % 4];
				const dp = along(p) - fold;
				const dq = along(q) - fold;
				if (dp >= 0) out.push(p);
				if (dp >= 0 !== (dq >= 0)) {
					const t = dp / (dp - dq);
					out.push([p[0] + t * (q[0] - p[0]), p[1] + t * (q[1] - p[1])]);
				}
			});
			return out;
		}

		overlay = el('svg', { class: 'peel-overlay', width: w, height: h, viewBox: `0 0 ${w} ${h}` });
		const defs = el('defs', {}, overlay);
		const paper = gradient(
			'peel-paper',
			[[0, 'var(--peel-crease)'], [0.05, 'var(--peel-light)'], [0.45, 'var(--peel-paper)'], [1, 'var(--peel-tip)']],
			defs,
		);
		const shade = gradient('peel-shade', [[0, 'rgb(0 0 0 / 0.45)'], [1, 'rgb(0 0 0 / 0)']], defs);
		const shadow = el('filter', { id: 'peel-shadow', x: '-25%', y: '-25%', width: '150%', height: '150%' }, defs);
		el('feDropShadow', { dx: 0, dy: 0, stdDeviation: 10, 'flood-color': '#000', 'flood-opacity': 0.3 }, shadow);
		const shading = el('polygon', { fill: 'url(#peel-shade)' }, overlay);
		const flap = el('polygon', { fill: 'url(#peel-paper)', filter: 'url(#peel-shadow)' }, overlay);
		document.body.append(overlay);
		page.style.visibility = 'visible';
		// Starts a stand-in that moves.
		page.dispatchEvent(new Event('peel'));

		const start = performance.now();
		const frameStep = (now: number) => {
			const t = Math.min((now - start) / DURATION, 1);
			const fold = length * (1 - ease(t));
			const depth = length - fold;
			const open = revealed(fold);
			// The lifted part, folded back over the page.
			const back = open.map(([x, y]): Point => {
				const d = 2 * (along([x, y]) - fold);
				return [x - d * n[0], y - d * n[1]];
			});
			const [fx, fy] = [n[0] * fold, n[1] * fold];
			const reach = Math.min(90, depth);
			for (const [node, toward] of [[paper, -depth], [shade, reach]] as const) {
				node.setAttribute('x1', String(fx));
				node.setAttribute('y1', String(fy));
				node.setAttribute('x2', String(fx + n[0] * toward));
				node.setAttribute('y2', String(fy + n[1] * toward));
			}
			page.style.clipPath = open.length
				? `polygon(${open.map(([x, y]) => `${x}px ${y}px`).join(', ')})`
				: 'polygon(0 0, 0 0, 0 0)';
			shading.setAttribute('points', points(open));
			flap.setAttribute('points', points(back));
			if (t < 1) requestAnimationFrame(frameStep);
			else location.assign(link.href);
		};
		requestAnimationFrame(frameStep);
	}

	for (const type of ['pointerover', 'pointerdown', 'focusin']) {
		document.addEventListener(type, (event) => {
			const link = peelLink(event.target);
			if (link) prepare(link);
		});
	}

	document.addEventListener('click', (event) => {
		const link = peelLink(event.target);
		if (!link || overlay || event.defaultPrevented) return;
		if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		event.preventDefault();
		peel(link);
	});

	// Coming back with the back button can restore this page mid-peel.
	addEventListener('pageshow', (event) => {
		if (!event.persisted) return;
		overlay?.remove();
		overlay = undefined;
		if (frame) {
			frame.style.visibility = '';
			frame.style.clipPath = '';
		}
	});
</script>

<style is:global>
	.peel-frame {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		z-index: 2147483646;
		visibility: hidden;
		pointer-events: none;
		clip-path: polygon(0 0, 0 0, 0 0);
	}
	.peel-overlay {
		position: fixed;
		inset: 0;
		z-index: 2147483647;
	}
	.peel-frame canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
	/* A curled corner on a card that peels, hinting at the peel that follows a click. The card is positioned. */
	.peel-card {
		overflow: hidden;
	}
	.peel-card::before {
		content: '';
		position: absolute;
		right: 0;
		bottom: 0;
		width: 0;
		height: 0;
		background: linear-gradient(
			to top left,
			var(--bg) 50%,
			var(--peel-crease) 50%,
			var(--peel-light) 56%,
			var(--peel-paper) 75%,
			var(--peel-tip)
		);
		box-shadow: -2px -2px 8px rgb(14 18 32 / 0.18);
		border-top-left-radius: 4px;
		transition:
			width 0.25s ease-out,
			height 0.25s ease-out;
	}
	.peel-card:hover::before {
		width: 3.5rem;
		height: 3.5rem;
	}
	@media (prefers-reduced-motion: reduce) {
		.peel-card::before {
			transition: none;
		}
	}
</style>
