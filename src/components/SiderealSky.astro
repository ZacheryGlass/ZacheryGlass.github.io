---
// The animated night sky behind the Sidereal page. Commits light up one by one as stars in a slowly turning sky, then
// the constellation straightens into the Sidereal mark, landing in the element marked data-sky-mark beside the page's
// own title and scrolling away with it. The sky stays fixed behind the page and turns a little as the page scrolls.
// The intro plays once; with reduced motion the sky shows its last frame and stays still. The page's h1 carries the
// name for screen readers and search engines, so the canvas is hidden from them.
---

<div class="sky">
	<canvas aria-hidden="true"></canvas>
</div>

<script>
	// The font is bundled here rather than in the site's font list so only this page downloads it.
	import monoUrl from '../assets/fonts/jetbrains-mono-latin-400-normal.woff2?url';

	type RGB = [number, number, number];
	type Point = { x: number; y: number };
	type Star = { r: number; a: number; b: number; size: number; f: number; ph: number; col: RGB };
	type Node = {
		i: number;
		lane: number;
		row: number;
		head: boolean;
		hash: string;
		/** How far the star sits off its place in the constellation, before scaling. */
		jx: number;
		jy: number;
		mag: number;
		ax: number;
		ay: number;
		bx: number;
		by: number;
		x: number;
		y: number;
	};
	type Edge = { from: Node; to: Node; lane: number };

	/** CSS pixels per design unit. Everything is drawn in design units, so the sky looks the same at any size. */
	const SCALE = 0.35;
	const TAU = Math.PI * 2;
	const MONO = '"Sidereal Mono", ui-monospace, monospace';
	/** Type size for the star labels, in design units. */
	const LABEL = 26;
	/** Radians per second: one turn of the sky every 23 minutes or so. */
	const OMEGA = 0.0045;
	/** Radians per CSS pixel scrolled. */
	const SCROLL_TURN = 0.00015;
	/** Stars per square design unit. */
	const DENSITY = 2.29e-4;
	// Sidereal's own lane colors, plus a third for the second branch.
	const LANE: Record<number, RGB> = { 0: [101, 167, 250], 1: [231, 138, 69], [-1]: [185, 140, 235] };
	const LINE: RGB = [190, 208, 255];
	/** When the constellation straightens into the mark, in seconds from the start. */
	const SNAP = [3.85, 5.1];
	/** After this, nothing but the sky changes. */
	const SETTLED = 5.6;

	const clamp = (x: number, a = 0, b = 1) => Math.min(b, Math.max(a, x));
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const prog = (t: number, a: number, b: number) => clamp((t - a) / (b - a));
	const easeOut = (x: number) => 1 - Math.pow(1 - x, 3);
	const easeInOut = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
	const mix = (a: RGB, b: RGB, t: number): RGB => [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)];
	const rgba = (c: RGB, a: number) => `rgba(${c[0] | 0},${c[1] | 0},${c[2] | 0},${clamp(a).toFixed(4)})`;
	/** When a commit lights up, in seconds from the start. */
	const litAt = (n: Node) => 0.95 + n.i * 0.29;
	function seeded(seed: number) {
		return () => {
			seed = (seed + 0x6d2b79f5) | 0;
			let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
			t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
			return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
		};
	}
	function canvas(w: number, h: number) {
		const c = document.createElement('canvas');
		c.width = Math.max(1, Math.round(w));
		c.height = Math.max(1, Math.round(h));
		return c;
	}
	function glowSprite(rgb: RGB) {
		const c = canvas(128, 128);
		const g = c.getContext('2d')!;
		const gr = g.createRadialGradient(64, 64, 0, 64, 64, 64);
		gr.addColorStop(0, rgba(rgb, 1));
		gr.addColorStop(0.18, rgba(rgb, 0.45));
		gr.addColorStop(0.45, rgba(rgb, 0.12));
		gr.addColorStop(1, rgba(rgb, 0));
		g.fillStyle = gr;
		g.fillRect(0, 0, 128, 128);
		return c;
	}
	const GLOW_W = glowSprite([235, 242, 255]);
	const GLOW_B = glowSprite([150, 185, 255]);

	class Scene {
		W: number;
		H: number;
		/** The point the sky turns around, far above the frame. */
		pole: Point;
		stars: Star[] = [];
		nebula: HTMLCanvasElement;
		grain: CanvasPattern | null = null;
		nodes: Node[] = [];
		edges: Edge[] = [];
		/** The mark's row spacing, which sizes the commits in it. */
		markRow = 30;

		constructor(W: number, H: number, c: CanvasRenderingContext2D) {
			this.W = W;
			this.H = H;
			const pole = (this.pole = { x: W * 0.62, y: -1500 });
			const R = seeded(20261029);
			// Stars fill the whole ring the frame passes through as the sky turns, so it never runs out of them.
			const corners = [
				[0, 0],
				[W, 0],
				[0, H],
				[W, H],
			];
			const rMin = -pole.y - 60;
			const rMax = Math.max(...corners.map(([x, y]) => Math.hypot(x - pole.x, y - pole.y))) + 60;
			const count = Math.round(DENSITY * Math.PI * (rMax * rMax - rMin * rMin));
			for (let i = 0; i < count; i++) {
				const b = Math.pow(R(), 3.2);
				const tint = R();
				const col: RGB = tint < 0.14 ? [255, 222, 196] : tint > 0.78 ? [196, 214, 255] : [236, 241, 255];
				this.stars.push({
					r: Math.sqrt(rMin * rMin + R() * (rMax * rMax - rMin * rMin)),
					a: R() * TAU,
					b,
					size: (0.35 + b * 1.65) * 1.45,
					f: 0.25 + R() * 1.1,
					ph: R() * TAU,
					col,
				});
			}

			// A faint band of nebula, drawn once at half size.
			this.nebula = canvas(W / 2, H / 2);
			const n = this.nebula.getContext('2d')!;
			n.scale(0.5, 0.5);
			n.globalCompositeOperation = 'lighter';
			for (let k = 0; k < 18; k++) {
				const u = k / 17;
				const px = lerp(-80, W + 30, u) + (R() - 0.5) * 260;
				const py = lerp(H - 30, -230, u) + (R() - 0.5) * 220;
				const rad = 240 + R() * 330;
				const col: RGB = k % 3 === 0 ? [118, 82, 196] : [64, 98, 206];
				const a = 0.03 + R() * 0.045;
				const gr = n.createRadialGradient(px, py, 0, px, py, rad);
				gr.addColorStop(0, rgba(col, a));
				gr.addColorStop(1, rgba(col, 0));
				n.fillStyle = gr;
				n.fillRect(px - rad, py - rad, rad * 2, rad * 2);
			}

			// Static grain, so the dark gradients don't band.
			const g = canvas(256, 256);
			const gc = g.getContext('2d')!;
			const d = gc.createImageData(256, 256);
			for (let i = 0; i < d.data.length; i += 4) {
				const v = R() * 255;
				d.data[i] = d.data[i + 1] = d.data[i + 2] = v;
				d.data[i + 3] = 9;
			}
			gc.putImageData(d, 0, 0);
			this.grain = c.createPattern(g, 'repeat');

			// The history: main, a branch merged back, then a second branch merged into HEAD. Row 0 is the oldest.
			const spec: [string, number, number, string[]][] = [
				['m0', 0, 0, []],
				['m1', 0, 1, ['m0']],
				['f1', 1, 2, ['m1']],
				['m2', 0, 3, ['m1']],
				['f2', 1, 4, ['f1']],
				['m3', 0, 5, ['m2', 'f2']],
				['h1', -1, 6, ['m3']],
				['m4', 0, 7, ['m3']],
				['m5', 0, 8, ['m4', 'h1']],
			];
			const hex = '0123456789abcdef';
			const byId = new Map<string, Node>();
			spec.forEach(([id, lane, row], i) => {
				let hash = '';
				for (let k = 0; k < 7; k++) hash += hex[Math.floor(R() * 16)];
				const node: Node = {
					i,
					lane,
					row,
					head: id === 'm5',
					hash,
					jx: (R() - 0.5) * 64,
					jy: (R() - 0.5) * 26,
					mag: id === 'm5' ? 1 : 0.5 + R() * 0.4,
					ax: 0,
					ay: 0,
					bx: 0,
					by: 0,
					x: 0,
					y: 0,
				};
				byId.set(id, node);
				this.nodes.push(node);
			});
			spec.forEach(([id, , , parents]) => {
				const to = byId.get(id)!;
				for (const p of parents) {
					const from = byId.get(p)!;
					this.edges.push({ from, to, lane: to.lane !== 0 ? to.lane : from.lane });
				}
			});
			this.fitMark(W / 3, 0, W / 3, H);
		}

		/** Fits the mark into a box, in design units, with the tilted constellation it straightens from around it. */
		fitMark(x: number, y: number, w: number, h: number) {
			const row = (this.markRow = Math.min((h * 0.7) / 8, w * 0.24));
			const lane = (row * 50) / 30;
			// Looser than the mark, but kept inside the box so the first stars don't start at its edge.
			const rowGap = row * 1.2;
			const laneGap = lane * 2;
			const cx = x + w / 2;
			const cy = y + h / 2;
			const tilt = -0.22;
			const s = rowGap / 68;
			for (const n of this.nodes) {
				n.bx = cx + n.lane * lane;
				n.by = cy - (n.row - 4) * row;
				const lx = n.lane * laneGap + n.jx * s;
				const ly = -(n.row - 4) * rowGap + n.jy * s;
				n.ax = cx + lx * Math.cos(tilt) - ly * Math.sin(tilt);
				n.ay = cy + lx * Math.sin(tilt) + ly * Math.cos(tilt);
			}
		}
	}

	class Sky {
		root: HTMLElement;
		cv: HTMLCanvasElement;
		c: CanvasRenderingContext2D;
		scene: Scene | null = null;
		/** Where the mark lands. */
		anchor = document.querySelector<HTMLElement>('[data-sky-mark]');
		/** Design units to device pixels. */
		k = 1;
		fontsReady = false;
		reduced = matchMedia('(prefers-reduced-motion: reduce)');
		raf = 0;
		start: number | null = null;
		last = 0;
		/** When the page last scrolled, so the sky keeps up with it at full frame rate. */
		scrolled = 0;

		constructor(root: HTMLElement) {
			this.root = root;
			this.cv = root.querySelector('canvas')!;
			this.c = this.cv.getContext('2d')!;
			new ResizeObserver(() => this.resize()).observe(root);
			this.reduced.addEventListener('change', () => this.update());
			addEventListener(
				'scroll',
				() => {
					this.scrolled = performance.now();
					// With reduced motion nothing animates, but the mark still follows the title.
					if (this.reduced.matches && !this.raf) this.raf = requestAnimationFrame(() => this.update());
				},
				{ passive: true },
			);
			new FontFace('Sidereal Mono', `url(${monoUrl})`)
				.load()
				.then((loaded) => document.fonts.add(loaded))
				.catch(() => undefined)
				.then(() => {
					this.fontsReady = true;
					this.update();
				});
			this.resize();
		}

		resize() {
			const w = this.root.clientWidth;
			const h = this.root.clientHeight;
			if (!w || !h) return;
			// It fills the window, so it draws fewer pixels than it could on dense screens.
			const dpr = Math.min(devicePixelRatio || 1, 1.5);
			this.cv.width = Math.round(w * dpr);
			this.cv.height = Math.round(h * dpr);
			this.k = dpr * SCALE;
			this.scene = new Scene(w / SCALE, h / SCALE, this.c);
			this.update();
		}

		/** Starts the animation, or with reduced motion draws its last frame. */
		update() {
			cancelAnimationFrame(this.raf);
			this.raf = 0;
			if (!this.scene || !this.fontsReady) return;
			if (this.reduced.matches) {
				this.draw(SETTLED + 0.3, false);
				return;
			}
			const frame = (now: number) => {
				this.raf = requestAnimationFrame(frame);
				if (this.start === null) this.start = now;
				const t = (now - this.start) / 1000;
				// Once settled, 30 frames a second is plenty for a slow sky, unless the page is scrolling.
				if (t > SETTLED && now - this.last < 32 && now - this.scrolled > 200) return;
				this.last = now;
				this.draw(t, true);
			};
			this.raf = requestAnimationFrame(frame);
		}

		/** Lands the mark on its anchor, which scrolls with the page. */
		placeMark(s: Scene) {
			const box = this.anchor?.getBoundingClientRect();
			const frame = this.cv.getBoundingClientRect();
			if (box?.width && box.height) {
				s.fitMark((box.left - frame.left) / SCALE, (box.top - frame.top) / SCALE, box.width / SCALE, box.height / SCALE);
			}
		}

		draw(t: number, moving: boolean) {
			const { c } = this;
			const s = this.scene!;
			this.placeMark(s);
			c.setTransform(1, 0, 0, 1, 0, 0);
			c.clearRect(0, 0, this.cv.width, this.cv.height);
			// Draw in design units from here on.
			c.setTransform(this.k, 0, 0, this.k, 0, 0);
			c.globalAlpha = 1;
			c.globalCompositeOperation = 'source-over';
			this.drawSky(s, t, moving);
			this.drawGraph(s, t);
			const { W, H } = s;
			const vg = c.createRadialGradient(W / 2, H / 2, H * 0.35, W / 2, H / 2, Math.max(W, H) * 0.66);
			vg.addColorStop(0, 'rgba(0,0,0,0)');
			vg.addColorStop(1, 'rgba(0,0,0,0.55)');
			c.fillStyle = vg;
			c.fillRect(0, 0, W, H);
			if (s.grain) {
				c.fillStyle = s.grain;
				c.fillRect(0, 0, W, H);
			}
			const fade = moving ? 1 - easeOut(prog(t, 0, 1)) : 0;
			if (fade > 0) {
				c.fillStyle = `rgba(3,5,12,${fade})`;
				c.fillRect(0, 0, W, H);
			}
		}

		glow(sprite: HTMLCanvasElement, x: number, y: number, r: number, a: number) {
			if (a <= 0 || r <= 0) return;
			this.c.globalAlpha = clamp(a);
			this.c.drawImage(sprite, x - r, y - r, r * 2, r * 2);
			this.c.globalAlpha = 1;
		}

		drawSky(s: Scene, t: number, moving: boolean) {
			const { c } = this;
			const { W, H, pole } = s;
			const bg = c.createRadialGradient(W * 0.5, H * 0.56, 0, W * 0.5, H * 0.56, Math.max(W, H) * 0.78);
			bg.addColorStop(0, '#0e1733');
			bg.addColorStop(0.55, '#080e21');
			bg.addColorStop(1, '#03050c');
			c.fillStyle = bg;
			c.fillRect(0, 0, W, H);
			c.drawImage(s.nebula, 0, 0, W, H);

			const rot = OMEGA * t + (moving ? scrollY * SCROLL_TURN : 0);
			// Right ascension spokes and declination circles around the pole, turning with the stars.
			const gridAlpha = 0.06 * prog(t, 0.3, 1.6) * lerp(1, 0.55, prog(t, 4.2, 5.6));
			if (gridAlpha > 0) {
				c.save();
				c.translate(pole.x, pole.y);
				c.rotate(rot);
				c.strokeStyle = `rgba(140,172,255,${gridAlpha})`;
				c.lineWidth = Math.max(1, 1.1 / (this.k / (devicePixelRatio || 1)));
				for (let r = 1520; r <= 3000; r += 230) {
					c.beginPath();
					c.arc(0, 0, r, 0, TAU);
					c.stroke();
				}
				c.beginPath();
				for (let a = 0; a < TAU; a += 0.075) {
					c.moveTo(1400 * Math.cos(a), 1400 * Math.sin(a));
					c.lineTo(3100 * Math.cos(a), 3100 * Math.sin(a));
				}
				c.stroke();
				c.restore();
			}

			for (const st of s.stars) {
				const an = st.a + rot;
				const x = pole.x + st.r * Math.cos(an);
				const y = pole.y + st.r * Math.sin(an);
				if (x < -16 || x > W + 16 || y < -16 || y > H + 16) continue;
				const twinkle = moving ? 0.7 + 0.3 * Math.sin(TAU * st.f * t + st.ph) : 0.85;
				const a = (0.22 + 0.78 * st.b) * twinkle;
				if (st.b > 0.3) this.glow(st.col[0] < 220 ? GLOW_B : GLOW_W, x, y, st.size * 7, a * 0.45);
				c.fillStyle = rgba(st.col, a);
				c.beginPath();
				c.arc(x, y, st.size, 0, TAU);
				c.fill();
			}
		}

		drawGraph(s: Scene, t: number) {
			const { c } = this;
			const snap = easeInOut(prog(t, SNAP[0], SNAP[1]));
			const dot = s.markRow / 30;
			for (const n of s.nodes) {
				n.x = lerp(n.ax, n.bx, snap);
				n.y = lerp(n.ay, n.by, snap);
			}

			// Constellation hairlines that thicken into the lanes of a commit graph.
			c.lineCap = 'round';
			const hairline = Math.max(1.4, 1.2 / (this.k / (devicePixelRatio || 1)));
			for (const e of s.edges) {
				const tl = litAt(e.to);
				const p = easeOut(prog(t, tl - 0.36, tl - 0.02));
				if (p <= 0) continue;
				const ex = lerp(e.from.x, e.to.x, p);
				const ey = lerp(e.from.y, e.to.y, p);
				c.strokeStyle = rgba(mix(LINE, LANE[e.lane], snap), lerp(0.5, 1, snap));
				c.lineWidth = lerp(hairline, 4.6 * dot, snap);
				c.beginPath();
				c.moveTo(e.from.x, e.from.y);
				c.lineTo(ex, ey);
				c.stroke();
				if (p < 1) {
					this.glow(GLOW_W, ex, ey, 16, 0.9);
					c.fillStyle = 'rgba(255,255,255,0.95)';
					c.beginPath();
					c.arc(ex, ey, 1.8, 0, TAU);
					c.fill();
				}
			}

			const labelAlpha = 1 - prog(t, SNAP[0], SNAP[0] + 0.45);
			c.font = `400 ${LABEL}px ${MONO}`;
			for (const n of s.nodes) {
				const tl = litAt(n);
				const on = easeOut(prog(t, tl - 0.04, tl + 0.2));
				const pulse = t > tl ? Math.exp(-(t - tl) * 4.2) : 0;
				const twinkle = 0.88 + 0.12 * Math.sin(t * 2.4 + n.i * 1.7);
				const faint = 0.4 * prog(t, 0.2, 1.1) * (1 - on);

				// As a star.
				if (snap < 1) {
					const a = Math.max(faint, on) * (1 - snap) * twinkle;
					const gr = lerp(7, 18 + 16 * n.mag, on) + pulse * (n.head ? 60 : 30);
					this.glow(GLOW_B, n.x, n.y, gr * 1.6, a * 0.5);
					this.glow(GLOW_W, n.x, n.y, gr, a * 0.9);
					c.fillStyle = `rgba(250,252,255,${clamp(a)})`;
					c.beginPath();
					c.arc(n.x, n.y, lerp(1.3, 2.4 + 1.6 * n.mag, on) + pulse * 1.6, 0, TAU);
					c.fill();
					if (n.head) this.spikes(n.x, n.y, lerp(0, 58, on) + pulse * 40, 0.85 * a, 1.6);
				}
				// As a commit in the mark.
				if (snap > 0) {
					const r = (n.head ? 9.5 : 5.8) * dot;
					c.fillStyle = `rgba(9,15,34,${snap})`;
					c.beginPath();
					c.arc(n.x, n.y, r + 3 * dot, 0, TAU);
					c.fill();
					c.fillStyle = rgba(LANE[n.lane], snap);
					c.beginPath();
					c.arc(n.x, n.y, r, 0, TAU);
					c.fill();
					if (n.head) {
						const breathe = 0.75 + 0.25 * Math.sin(t * 2.1);
						this.glow(GLOW_W, n.x, n.y, 42 * dot, 0.55 * snap * breathe);
						c.fillStyle = `rgba(255,255,255,${snap})`;
						c.beginPath();
						c.arc(n.x, n.y, 4.2 * dot, 0, TAU);
						c.fill();
						this.spikes(n.x, n.y, 30 * dot * breathe, 0.9 * snap, 1.3 * dot);
					}
				}
				// Short hashes beside each star, like a star catalogue.
				const la = on * labelAlpha * 0.66;
				if (la > 0) {
					const lx = n.x + (n.head ? 34 : 16);
					const ly = n.y + LABEL * 0.33;
					c.fillStyle = `rgba(172,192,236,${la})`;
					c.fillText(n.hash, lx, ly);
					if (n.head) {
						c.fillStyle = `rgba(240,200,130,${clamp(la * 1.25)})`;
						c.fillText('HEAD → main', lx + c.measureText(n.hash + '  ').width, ly);
					}
				}
			}
		}

		spikes(x: number, y: number, len: number, a: number, width: number) {
			if (a <= 0 || len <= 0) return;
			const { c } = this;
			c.save();
			c.translate(x, y);
			for (let k = 0; k < 4; k++) {
				c.rotate(Math.PI / 2);
				const g = c.createLinearGradient(0, 0, len, 0);
				g.addColorStop(0, `rgba(245,248,255,${clamp(a)})`);
				g.addColorStop(1, 'rgba(245,248,255,0)');
				c.fillStyle = g;
				c.beginPath();
				c.moveTo(0, -width);
				c.lineTo(len, 0);
				c.lineTo(0, width);
				c.closePath();
				c.fill();
			}
			c.restore();
		}
	}

	document.querySelectorAll<HTMLElement>('.sky').forEach((root) => new Sky(root));
</script>

<style>
	/* Fixed behind the page's content, above the page's own background. */
	.sky {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		background: #050813;
	}
