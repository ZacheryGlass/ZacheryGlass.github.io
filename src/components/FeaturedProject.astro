---
import ChainSupply from './ChainSupply.astro';
import GitGraph from './GitGraph.astro';
import { cardPeel, peelAttrs, type Project } from '../data/projects';
import type { Counts, Release } from '../data/github';
import { formatDate } from '../data/site';

interface Props {
	project: Project;
	/** Read from GitHub at build time; left out when the request failed. */
	release?: Release;
	counts?: Counts;
}

const { project, release, counts } = Astro.props;
const hero = project.featured === 'hero';
const arts = { 'git-graph': GitGraph, 'chain-supply': ChainSupply };
const Art = project.art && arts[project.art];
const peel = cardPeel(project);
// The whole card links to the page it peels to, or, below the hero, to the main link.
const cardHref = peel?.href ?? (hero ? undefined : project.links[0].href);
const peelAttr = (href: string) => (peel && href === peel.href ? peelAttrs(peel) : {});
---

<li class:list={['featured', { hero, 'has-art': Art, 'peel-card': Boolean(peel) }]}>
	<div class="text">
		<p class="kind">{project.kind}</p>
		<h2>
			{
				cardHref ? (
					<a href={cardHref} {...peelAttr(cardHref)}>
						{project.name}
					</a>
				) : (
					project.name
				)
			}
		</h2>
		<p class="description">{project.description}</p>
		{release && <p class="release">{release.tag} · released {formatDate(release.date)}</p>}
		<p class="links">
			{
				project.links.map((link, i) => (
					<a class:list={{ button: hero && i === 0 }} href={link.href} {...peelAttr(link.href)}>
						{link.label}
					</a>
				))
			}
		</p>
	</div>
	{
		Art && (
			<div class="art">
				<Art />
			</div>
		)
	}
	{
		counts && (
			<p class="counts">
				<span>
					<strong>{counts.stars.toLocaleString('en-US')}</strong> {counts.stars === 1 ? 'star' : 'stars'}
				</span>
				<span>
					<strong>{counts.forks.toLocaleString('en-US')}</strong> {counts.forks === 1 ? 'fork' : 'forks'}
				</span>
			</p>
		)
	}
</li>

<style>
	.featured {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 2.5rem 4rem;
		padding: clamp(1.75rem, 5vw, 3.5rem);
		background: var(--surface);
		border-radius: 20px;
	}
	.has-art {
		grid-template-columns: 1fr 1fr;
	}
	/* The whole card is a link; the other links sit above it. */
	.featured {
		position: relative;
	}
	.featured h2 a,
	.featured h2 a:hover {
		color: inherit;
		text-decoration: none;
	}
	h2 a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 20px;
	}
	.hero h2 a::after {
		border-radius: 24px;
	}
	h2 a:focus-visible {
		outline: none;
	}
	.featured:has(h2 a:focus-visible) {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}
	.featured .links {
		position: relative;
		z-index: 1;
	}
	.hero {
		background: var(--hero-bg);
		border: 1px solid var(--hero-border);
		border-radius: 24px;
		color: var(--hero-text);
	}
	.kind {
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.3;
		color: var(--muted);
	}
	.hero .kind,
	.release {
		color: var(--hero-muted);
	}
	h2 {
		margin-top: 1rem;
		font-size: clamp(2.5rem, 1.5rem + 2.75vw, 3.375rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.03em;
		color: var(--heading);
	}
	.hero h2 {
		font-size: clamp(3rem, 1.5rem + 4.5vw, 4.875rem);
		letter-spacing: -0.06em;
		color: var(--hero-heading);
	}
	.description {
		margin-top: 1.125rem;
		max-width: 40rem;
		font-size: 1.125rem;
		line-height: 1.65;
	}
	.hero .description {
		margin-top: 1.25rem;
	}
	.release {
		margin-top: 1.25rem;
		font-size: 0.875rem;
		line-height: 1.3;
		font-variant-numeric: tabular-nums;
	}
	.links {
		margin-top: 1.625rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.75rem;
		font-weight: 500;
	}
	.hero .links {
		margin-top: 1.5rem;
	}
	.hero a {
		color: var(--hero-link);
	}
	.hero a:hover {
		color: var(--hero-link-hover);
	}
	.hero .art {
		margin-top: 1.25rem;
	}
	.hero a:focus-visible {
		outline-color: var(--hero-link);
	}
	.hero a.button {
		padding: 0.875rem 1.5rem;
		font-weight: 600;
		line-height: 1.3;
		text-decoration: none;
		color: var(--hero-button-text);
		background: var(--hero-button);
		border-radius: 10px;
	}
	.hero a.button:hover {
		background: var(--hero-button-hover);
	}
	.hero a.button:focus-visible {
		outline-offset: 3px;
	}
	.counts {
		display: flex;
		gap: 3rem;
		font-size: 0.875rem;
		line-height: 1.3;
		color: var(--muted);
	}
	.counts strong {
		display: block;
		margin-bottom: 0.5rem;
		font-size: clamp(2.75rem, 2rem + 2.25vw, 3.75rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.03em;
		color: var(--heading);
	}
	@media (max-width: 52rem) {
		.featured {
			grid-template-columns: 1fr;
		}
		.art {
			display: none;
		}
	}
</style>
