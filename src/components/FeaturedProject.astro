---
import ChainSupply from './ChainSupply.astro';
import GitGraph from './GitGraph.astro';
import type { Project } from '../data/projects';
import type { Counts, Release } from '../data/github';
import { formatDate } from '../data/site';

interface Props {
	project: Project;
	/** Read from GitHub at build time; left out when the request failed. */
	release?: Release;
	counts?: Counts;
}

const { project, release, counts } = Astro.props;
const hero = project.featured === 'hero';
const arts = { 'git-graph': GitGraph, 'chain-supply': ChainSupply };
const Art = project.art && arts[project.art];
const main = project.links[0];
const peel = project.peel?.background;
const peelAttr = (href: string) => (peel && href === main.href ? peel : undefined);
---

<li class:list={['featured', { hero, 'has-art': Art, peel }]}>
	<div class="text">
		<p class="kind">{project.kind}</p>
		<h2>
			{
				hero ? (
					project.name
				) : (
					<a href={main.href} data-peel={peelAttr(main.href)}>
						{project.name}
					</a>
				)
			}
		</h2>
		<p class="description">{project.description}</p>
		{release && <p class="release">{release.tag} · released {formatDate(release.date)}</p>}
		<p class="links">
			{
				project.links.map((link, i) => (
					<a class:list={{ button: hero && i === 0 }} href={link.href} data-peel={peelAttr(link.href)}>
						{link.label}
					</a>
				))
			}
		</p>
	</div>
	{
		Art && (
			<div class="art">
				<Art />
			</div>
		)
	}
	{
		counts && (
			<p class="counts">
				<span>
					<strong>{counts.stars.toLocaleString('en-US')}</strong> {counts.stars === 1 ? 'star' : 'stars'}
				</span>
				<span>
					<strong>{counts.forks.toLocaleString('en-US')}</strong> {counts.forks === 1 ? 'fork' : 'forks'}
				</span>
			</p>
		)
	}
</li>

<style>
	.featured {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 2.5rem 4rem;
		padding: clamp(1.75rem, 5vw, 3.5rem);
		background: var(--surface);
		border-radius: 20px;
	}
	.has-art {
		grid-template-columns: 1fr 1fr;
	}
	/* Below the hero, the whole card is the main link; the other links sit above it. */
	.featured:not(.hero) {
		position: relative;
	}
	h2 a {
		color: inherit;
		text-decoration: none;
	}
	h2 a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 20px;
	}
	h2 a:focus-visible {
		outline: none;
	}
	.featured:has(h2 a:focus-visible) {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}
	.featured:not(.hero) .links {
		position: relative;
		z-index: 1;
	}
	/* A curled corner on hover, hinting at the peel that follows a click. */
	.peel {
		overflow: hidden;
	}
	.peel::before {
		content: '';
		position: absolute;
		right: 0;
		bottom: 0;
		width: 0;
		height: 0;
		background: linear-gradient(
			to top left,
			var(--bg) 50%,
			var(--peel-crease) 50%,
			var(--peel-light) 56%,
			var(--peel-paper) 75%,
			var(--peel-tip)
		);
		box-shadow: -2px -2px 8px rgb(14 18 32 / 0.18);
		border-top-left-radius: 4px;
		transition:
			width 0.25s ease-out,
			height 0.25s ease-out;
	}
	.peel:hover::before {
		width: 3.5rem;
		height: 3.5rem;
	}
	@media (prefers-reduced-motion: reduce) {
		.peel::before {
			transition: none;
		}
	}
	.hero {
		background: var(--hero-bg);
		border: 1px solid var(--hero-border);
		border-radius: 24px;
		color: var(--hero-text);
	}
	.kind {
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.3;
		color: var(--muted);
	}
	.hero .kind,
	.release {
		color: var(--hero-muted);
	}
	h2 {
		margin-top: 1rem;
		font-size: clamp(2.5rem, 1.5rem + 2.75vw, 3.375rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.03em;
		color: var(--heading);
	}
	.hero h2 {
		font-size: clamp(3rem, 1.5rem + 4.5vw, 4.875rem);
		letter-spacing: -0.06em;
		color: var(--hero-heading);
	}
	.description {
		margin-top: 1.125rem;
		max-width: 40rem;
		font-size: 1.125rem;
		line-height: 1.65;
	}
	.hero .description {
		margin-top: 1.25rem;
	}
	.release {
		margin-top: 1.25rem;
		font-size: 0.875rem;
		line-height: 1.3;
		font-variant-numeric: tabular-nums;
	}
	.links {
		margin-top: 1.625rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.75rem;
		font-weight: 500;
	}
	.hero .links {
		margin-top: 1.5rem;
	}
	.hero a {
		color: var(--hero-link);
	}
	.hero a:hover {
		color: var(--hero-link-hover);
	}
	.hero .art {
		margin-top: 1.25rem;
	}
	.hero a:focus-visible {
		outline-color: var(--hero-link);
	}
	.hero a.button {
		padding: 0.875rem 1.5rem;
		font-weight: 600;
		line-height: 1.3;
		text-decoration: none;
		color: var(--hero-button-text);
		background: var(--hero-button);
		border-radius: 10px;
	}
	.hero a.button:hover {
		background: var(--hero-button-hover);
	}
	.hero a.button:focus-visible {
		outline-offset: 3px;
	}
	.counts {
		display: flex;
		gap: 3rem;
		font-size: 0.875rem;
		line-height: 1.3;
		color: var(--muted);
	}
	.counts strong {
		display: block;
		margin-bottom: 0.5rem;
		font-size: clamp(2.75rem, 2rem + 2.25vw, 3.75rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.03em;
		color: var(--heading);
	}
	@media (max-width: 52rem) {
		.featured {
			grid-template-columns: 1fr;
		}
		.art {
			display: none;
		}
	}
</style>
