---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	/** Numbers read from GitHub at build time, shown under the description. */
	stat?: string;
	featured?: boolean;
}

const { project, stat, featured = false } = Astro.props;
---

<li class:list={['project', { featured }]}>
	<p class="kind">{project.kind}</p>
	<h3>{project.name}</h3>
	<p class="description">{project.description}</p>
	{stat && <p class="stat">{stat}</p>}
	<p class="links">
		{project.links.map((link) => <a href={link.href}>{link.label}</a>)}
	</p>
</li>

<style>
	.project {
		display: flex;
		flex-direction: column;
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
	}
	.featured {
		padding: 1.5rem;
	}
	.kind {
		font-size: 0.75rem;
		color: var(--muted);
	}
	h3 {
		margin-top: 0.25rem;
		font-size: 1.0625rem;
		font-weight: 600;
		color: var(--heading);
	}
	.featured h3 {
		font-size: 1.25rem;
	}
	.description {
		margin-top: 0.5rem;
		font-size: 0.9375rem;
		flex: 1;
	}
	.featured .description {
		font-size: 1rem;
	}
	.stat {
		margin-top: 0.75rem;
		font-size: 0.8125rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.links {
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.875rem;
	}
</style>
