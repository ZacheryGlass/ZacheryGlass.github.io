---
import { cardPeel, peelAttrs, type Project } from '../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
const peel = cardPeel(project);
---

<li class:list={['project', { 'peel-card': Boolean(peel) }]}>
	<p class="kind">{project.kind}</p>
	<h3><a href={peel?.href ?? project.links[0].href} {...(peel ? peelAttrs(peel) : {})}>{project.name}</a></h3>
	<p class="description">{project.description}</p>
</li>

<style>
	.project {
		position: relative;
		padding: 2rem;
		background: var(--surface);
		border-radius: 16px;
		transition:
			box-shadow 0.15s,
			transform 0.15s;
	}
	.project:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px -12px rgb(14 18 32 / 0.25);
	}
	.kind {
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.3;
		color: var(--muted);
	}
	h3 {
		margin-top: 0.625rem;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--heading);
	}
	/* The whole card is the link. */
	h3 a,
	h3 a:hover {
		color: inherit;
		text-decoration: none;
	}
	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 16px;
	}
	h3 a:focus-visible {
		outline: none;
	}
	/* On the card, which clips what's inside it to draw the peel's curled corner. */
	.project:has(h3 a:focus-visible) {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}
	.description {
		margin-top: 0.875rem;
		line-height: 1.6;
	}
	@media (prefers-reduced-motion: reduce) {
		.project {
			transition: none;
		}
		.project:hover {
			transform: none;
		}
	}
</style>
