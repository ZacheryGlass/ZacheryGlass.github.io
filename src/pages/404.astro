---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Zachery Glass" description="This page doesn't exist.">
	<script is:inline>
		// The money app used to live at zacheryglass.com/private; old links go to its new address.
		if (location.pathname === '/private' || location.pathname.startsWith('/private/')) {
			location.replace('https://money.zacheryglass.com' + location.pathname + location.search + location.hash);
		}
	</script>
	<main>
		<h1>Page not found</h1>
		<p>There's nothing at this address. <a href="/">Go to the home page</a>.</p>
	</main>
</Base>

<style>
	main {
		max-width: 56rem;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}
	h1 {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 700;
		color: var(--heading);
	}
	p {
		margin-top: 0.75rem;
		color: var(--muted);
	}
</style>
