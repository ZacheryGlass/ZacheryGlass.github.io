---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Zachery Glass" description="This page doesn't exist.">
	<main>
		<h1>Page not found</h1>
		<p>There's nothing at this address. <a href="/">Go to the home page</a>.</p>
	</main>
</Base>

<style>
	main {
		max-width: 56rem;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}
	h1 {
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--heading);
	}
	p {
		margin-top: 0.75rem;
		color: var(--muted);
	}
</style>
