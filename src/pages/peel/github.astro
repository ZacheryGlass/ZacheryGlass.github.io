---
// A made-up GitHub repository page under a layer of blur, which PagePeel reveals in place of GitHub, since GitHub
// refuses to be framed. The repository is named in the hash, as owner/name; a project's name and description fill
// it in. It is always light, whatever the visitor's setting.
import { projects } from '../../data/projects';
import { bio } from '../../data/site';

const repos: Record<string, { name: string; description: string }> = {};
for (const project of projects) {
	for (const { href } of project.links) {
		const url = new URL(href, 'https://zacheryglass.com');
		if (url.hostname === 'github.com') repos[url.pathname.slice(1)] = { name: project.name, description: project.description };
	}
}

const tabs = ['Code', 'Issues', 'Pull requests', 'Actions', 'Projects', 'Security', 'Insights'];
const files = [
	{ name: '.github', folder: true, message: 'Add the issue templates', date: '2 weeks ago' },
	{ name: 'src', folder: true, message: 'Handle a missing config file', date: 'yesterday' },
	{ name: 'test', folder: true, message: 'Cover the empty repository case', date: 'yesterday' },
	{ name: '.gitignore', message: 'Ignore build output', date: 'last month' },
	{ name: 'LICENSE', message: 'Add the MIT license', date: 'last month' },
	{ name: 'README.md', message: 'Update the README', date: '3 days ago' },
];
const topics = ['developer-tools', 'git', 'open-source', 'productivity', 'typescript'];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="color-scheme" content="light" />
		<title>GitHub</title>
	</head>
	<body>
		<header class="global">
			<span class="logo"></span>
			<nav>
				{['Products', 'Developers', 'Businesses', 'Resources'].map((item) => <span class="menu">{item}</span>)}
				<span>Pricing</span>
			</nav>
			<span class="search">Search</span>
			<span class="sign-in">Sign in</span>
			<span class="sign-up">Sign up</span>
		</header>
		<div class="repo-head">
			<p><span data-owner></span> / <strong data-name></strong></p>
			<nav>{tabs.map((tab, i) => <span class:list={{ current: i === 0 }}><i></i>{tab}</span>)}</nav>
		</div>
		<main>
			<div class="title">
				<span class="avatar"></span>
				<strong data-name></strong>
				<span class="label">Public</span>
				<span class="actions">
					<span class="button">Notifications</span>
					<span class="button">Fork <b>0</b></span>
					<span class="button">Star <b>1</b></span>
				</span>
			</div>
			<div class="columns">
				<div>
					<div class="bar">
						<span class="button">main</span>
						<span class="count"><b>1</b> Branch</span>
						<span class="count"><b>3</b> Tags</span>
						<span class="find">Go to file</span>
						<span class="button code">Code</span>
					</div>
					<div class="box">
						<div class="commit">
							<span class="avatar"></span>
							<strong data-owner></strong>
							<span class="muted">Update the README</span>
							<span class="muted end">4 hours ago</span>
							<strong class="small">24 Commits</strong>
						</div>
						{
							files.map((file) => (
								<div class="file">
									<i class:list={{ folder: file.folder }} />
									<span>{file.name}</span>
									<span class="muted">{file.message}</span>
									<span class="muted end">{file.date}</span>
								</div>
							))
						}
					</div>
					<div class="box readme">
						<p class="readme-tab"><span>README</span></p>
						<article>
							<h1 data-title></h1>
							<p data-description></p>
							<h2>Install</h2>
							<pre>git clone https://github.com/<span data-owner></span>/<span data-name></span></pre>
							<h2>Usage</h2>
							<p>Open the project and run it from the command line. Settings are read from the config file in your home folder, and each one can be overridden for a single run.</p>
						</article>
					</div>
				</div>
				<aside>
					<h2>About</h2>
					<p data-description></p>
					<p class="link">zacheryglass.com</p>
					<p class="topics">{topics.map((topic) => <span>{topic}</span>)}</p>
					<ul>
						{['Readme', 'MIT license', 'Activity', '1 star', '0 watching', '0 forks'].map((item) => (
							<li>
								<i />
								{item}
							</li>
						))}
					</ul>
					<h2 class="rule">Releases</h2>
					<p class="release"><i></i><strong>v1.0.0</strong> <span class="latest">Latest</span></p>
					<h2 class="rule">Languages</h2>
					<p class="languages"><span></span><span></span><span></span></p>
				</aside>
			</div>
		</main>
		<div class="blur"></div>
		<script is:inline define:vars={{ repos, bio }}>
			const [owner, repo = owner] = decodeURIComponent(location.hash.slice(1)).split('/');
			const project = repos[`${owner}/${repo}`];
			const fill = (slot, text) => {
				for (const node of document.querySelectorAll(`[data-${slot}]`)) node.textContent = text;
			};
			fill('owner', owner);
			fill('name', repo);
			fill('title', project?.name ?? repo);
			fill('description', project?.description ?? bio);
		</script>
	</body>
</html>

<style is:global>
	:root {
		--header: #000000;
		--bg: #ffffff;
		--bg-muted: #f6f8fa;
		--border: #d1d9e0;
		--fg: #1f2328;
		--fg-muted: #59636e;
		--accent: #0969da;
		--topic: #ddf4ff;
		--green: #1f883d;
		--success: #1a7f37;
		--folder: #54aeff;
		--underline: #fd8c73;
		--avatar: #c9ad93;
	}
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}
	body {
		overflow: hidden;
		font:
			14px/1.5 -apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			'Noto Sans',
			Helvetica,
			Arial,
			sans-serif;
		color: var(--fg);
		background: var(--bg);
	}
	i {
		flex: none;
		display: inline-block;
		width: 16px;
		height: 16px;
		border: 1.5px solid var(--fg-muted);
		border-radius: 50%;
	}
	.muted {
		color: var(--fg-muted);
	}
	.avatar {
		flex: none;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: var(--avatar);
	}
	.button {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 28px;
		padding: 0 12px;
		font-size: 12px;
		font-weight: 500;
		background: var(--bg-muted);
		border: 1px solid var(--border);
		border-radius: 6px;
	}
	.button b {
		padding: 0 6px;
		background: var(--border);
		border-radius: 2em;
	}

	.global {
		display: flex;
		align-items: center;
		gap: 16px;
		height: 68px;
		padding: 0 16px;
		font-size: 16px;
		font-weight: 500;
		color: #ffffff;
		background: var(--header);
	}
	.logo {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: #ffffff;
	}
	.global nav {
		display: flex;
		gap: 36px;
		margin-left: 8px;
		flex: 1;
	}
	.menu::after {
		content: ' \25BE';
		font-size: 12px;
	}
	.search {
		width: 200px;
		padding: 6px 12px;
		font-size: 14px;
		color: #9198a1;
		border: 1px solid #3d444d;
		border-radius: 6px;
	}
	.sign-up {
		padding: 4px 12px;
		color: #1f2328;
		background: #ffffff;
		border-radius: 6px;
	}

	.repo-head {
		padding: 16px 24px 0;
		background: var(--bg-muted);
		border-bottom: 1px solid var(--border);
	}
	.repo-head p {
		font-size: 16px;
	}
	.repo-head strong {
		font-weight: 600;
	}
	.repo-head nav {
		display: flex;
		gap: 24px;
		margin-top: 14px;
	}
	.repo-head nav span {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 4px 14px;
		white-space: nowrap;
	}
	.repo-head .current {
		font-weight: 600;
		box-shadow: inset 0 -2px var(--underline);
	}

	main {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 32px;
	}
	.title {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 20px 0 16px;
		border-bottom: 1px solid var(--border);
	}
	.title .avatar {
		width: 24px;
		height: 24px;
	}
	.title strong {
		font-size: 20px;
		font-weight: 600;
	}
	.label {
		padding: 0 7px;
		font-size: 12px;
		color: var(--fg-muted);
		border: 1px solid var(--border);
		border-radius: 2em;
	}
	.actions {
		display: flex;
		gap: 8px;
		margin-left: auto;
	}
	.columns {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 272px;
		gap: 40px;
		padding-top: 24px;
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.bar .button {
		height: 32px;
		font-size: 14px;
	}
	.bar .count b {
		font-weight: 600;
	}
	.find {
		width: 204px;
		margin-left: auto;
		padding: 5px 12px;
		color: var(--fg-muted);
		border: 1px solid var(--border);
		border-radius: 6px;
	}
	.bar .code {
		margin-left: -8px;
		font-weight: 600;
		color: #ffffff;
		background: var(--green);
		border-color: transparent;
	}
	.box {
		margin-top: 16px;
		border: 1px solid var(--border);
		border-radius: 6px;
		overflow: hidden;
	}
	.commit,
	.file {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 16px;
	}
	.commit {
		height: 52px;
		background: var(--bg-muted);
	}
	.end {
		margin-left: auto;
		font-size: 12px;
	}
	.small {
		font-size: 12px;
	}
	.file {
		display: grid;
		grid-template-columns: 16px 1fr 1.4fr auto;
		gap: 10px;
		height: 41px;
		border-top: 1px solid var(--border);
	}
	.file i {
		width: 13px;
		height: 15px;
		border-radius: 2px;
	}
	.file i.folder {
		width: 16px;
		height: 13px;
		background: var(--folder);
		border-color: var(--folder);
	}
	.readme-tab {
		padding: 0 8px;
		border-bottom: 1px solid var(--border);
	}
	.readme-tab span {
		display: inline-block;
		padding: 12px 8px;
		font-weight: 600;
		box-shadow: inset 0 -2px var(--underline);
	}
	article {
		padding: 32px;
		font-size: 16px;
	}
	article h1 {
		overflow-wrap: anywhere;
		padding-bottom: 8px;
		margin-bottom: 16px;
		font-size: 32px;
		font-weight: 600;
		line-height: 1.25;
		border-bottom: 1px solid var(--border);
	}
	article h2 {
		margin: 24px 0 16px;
		padding-bottom: 6px;
		font-size: 24px;
		font-weight: 600;
		line-height: 1.25;
		border-bottom: 1px solid var(--border);
	}
	pre {
		padding: 16px;
		overflow: hidden;
		font: 13.6px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace;
		background: var(--bg-muted);
		border-radius: 6px;
	}

	aside {
		font-size: 16px;
	}
	aside h2 {
		margin-bottom: 16px;
		font-size: 16px;
		font-weight: 600;
	}
	aside h2.rule {
		margin-top: 24px;
		padding-top: 24px;
		border-top: 1px solid var(--border);
	}
	.link {
		margin-top: 16px;
		font-size: 14px;
		font-weight: 600;
		color: var(--accent);
	}
	.topics {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 4px;
		margin-top: 16px;
	}
	.topics span {
		padding: 0 10px;
		font-size: 12px;
		font-weight: 500;
		line-height: 22px;
		color: var(--accent);
		background: var(--topic);
		border-radius: 2em;
	}
	aside ul {
		list-style: none;
		margin-top: 16px;
		font-size: 14px;
		color: var(--fg-muted);
	}
	aside li {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-top: 8px;
	}
	.release {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 14px;
	}
	.release i {
		border-color: var(--success);
	}
	.latest {
		padding: 0 7px;
		font-size: 12px;
		color: var(--success);
		border: 1px solid var(--success);
		border-radius: 2em;
	}
	.languages {
		display: flex;
		gap: 2px;
		height: 8px;
		border-radius: 6px;
		overflow: hidden;
	}
	.languages span {
		flex: 70;
		background: #3178c6;
	}
	.languages span + span {
		flex: 22;
		background: #f1e05a;
	}
	.languages span:last-child {
		flex: 8;
		background: #563d7c;
	}

	@media (max-width: 1011px) {
		.global nav,
		.columns aside,
		.find {
			display: none;
		}
		.global .search {
			margin-left: auto;
		}
		.columns {
			grid-template-columns: minmax(0, 1fr);
		}
		.file {
			grid-template-columns: 16px 1fr auto;
		}
		.file .muted:not(.end) {
			display: none;
		}
	}
	@media (max-width: 767px) {
		.actions,
		.search,
		.commit .muted:not(.end) {
			display: none;
		}
		.sign-in {
			margin-left: auto;
		}
		main {
			padding: 0 16px;
		}
	}

	.blur {
		position: fixed;
		inset: 0;
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
	}
</style>
