---
import Base from '../layouts/Base.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import PagePeel from '../components/PagePeel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { latestRelease, repoCounts } from '../data/github';
import { getPosts } from '../data/writing';
import { description, formatDate, person } from '../data/site';

const featured = await Promise.all(
	projects
		.filter((project) => project.featured)
		.map(async (project) => ({
			project,
			release: project.repo && project.stat === 'release' ? await latestRelease(project.repo) : undefined,
			counts: project.repo && project.stat === 'stars' ? await repoCounts(project.repo) : undefined,
		})),
);
const more = projects.filter((project) => !project.featured);

const posts = await getPosts();
const structuredData = { '@context': 'https://schema.org', ...person, description };
---

<Base title="Zachery Glass" description={description} structuredData={structuredData}>
	<main>
		<header>
			<h1>Zachery Glass</h1>
			<nav aria-label="Elsewhere">
				<a href="https://github.com/ZacheryGlass">GitHub</a>
			</nav>
		</header>

		<ul class="featured" aria-label="Featured projects">
			{featured.map((props) => <FeaturedProject {...props} />)}
		</ul>

		<section aria-labelledby="more-projects">
			<h2 id="more-projects">More projects</h2>
			<ul class="projects">
				{more.map((project) => <ProjectCard project={project} />)}
			</ul>
		</section>

		{
			posts.length > 0 && (
				<section aria-labelledby="writing">
					<h2 id="writing">Writing</h2>
					<ul class="posts">
						{posts.map((post) => (
							<li class="post peel-card">
								<p class="date">
									<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
									{post.data.draft && ' · Draft'}
								</p>
								<h3>
									<a href={`/writing/${post.id}/`} data-peel="var(--bg)">{post.data.title}</a>
								</h3>
								<p class="standfirst">{post.data.description}</p>
							</li>
						))}
					</ul>
					<p class="feed">
						<a href="/rss.xml">RSS feed</a>
					</p>
				</section>
			)
		}
	</main>
	<PagePeel />
</Base>

<style>
	main {
		max-width: 73rem;
		margin: 0 auto;
		padding: 2.25rem clamp(1rem, 4vw, 1.5rem) 7rem;
	}
	header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}
	h1 {
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--heading);
	}
	header nav {
		font-weight: 500;
	}
	ul {
		list-style: none;
	}
	.featured {
		display: grid;
		gap: 1.5rem;
		margin-top: clamp(2rem, 5vw, 3.5rem);
	}
	section {
		margin-top: 4.125rem;
	}
	h2 {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--heading);
	}
	.projects {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
		gap: 1.25rem;
		margin-top: 1.1875rem;
	}
	.posts {
		display: grid;
		gap: 1.25rem;
		margin-top: 1.1875rem;
	}
	.post {
		position: relative;
		padding: 2rem;
		background: var(--surface);
		border-radius: 16px;
	}
	.post .date {
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.3;
		color: var(--muted);
	}
	.post h3 {
		margin-top: 0.75rem;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}
	/* The whole card is the link. */
	.post h3 a {
		color: var(--heading);
		text-decoration: none;
	}
	.post h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 16px;
	}
	.post h3 a:focus-visible {
		outline: none;
	}
	/* On the card, which clips what's inside it to draw the peel's curled corner. */
	.post:has(h3 a:focus-visible) {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}
	.post:hover h3 a {
		color: var(--link);
	}
	.standfirst {
		margin-top: 0.75rem;
		max-width: 44rem;
		line-height: 1.6;
	}
	.feed {
		margin-top: 1.5rem;
		font-weight: 500;
	}
</style>
