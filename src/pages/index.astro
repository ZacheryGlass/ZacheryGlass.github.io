---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { statLine } from '../data/github';
import { getPosts } from '../data/writing';
import { bio, description, formatDate, person } from '../data/site';

const featured = await Promise.all(
	projects.filter((project) => project.featured).map(async (project) => ({ project, stat: await statLine(project) })),
);
const more = projects.filter((project) => !project.featured);

const posts = await getPosts();
const structuredData = { '@context': 'https://schema.org', ...person, description };
---

<Base title="Zachery Glass" description={description} structuredData={structuredData}>
	<main>
		<header>
			<h1>Zachery Glass</h1>
			<p>{bio}</p>
			<nav aria-label="Elsewhere">
				<a href="https://github.com/ZacheryGlass">GitHub</a>
			</nav>
		</header>

		<section aria-labelledby="projects">
			<h2 id="projects">Projects</h2>
			<ul class="featured">
				{featured.map(({ project, stat }) => <ProjectCard project={project} stat={stat} featured />)}
			</ul>
			<p class="more" id="more-projects">More projects</p>
			<ul class="projects" aria-labelledby="more-projects">
				{more.map((project) => <ProjectCard project={project} />)}
			</ul>
		</section>

		{
			posts.length > 0 && (
				<section aria-labelledby="writing">
					<h2 id="writing">Writing</h2>
					<ul class="posts">
						{posts.map((post) => (
							<li class="post">
								<p class="date">
									<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
									{post.data.draft && ' · Draft'}
								</p>
								<h3>
									<a href={`/writing/${post.id}/`}>{post.data.title}</a>
								</h3>
								<p class="standfirst">{post.data.description}</p>
							</li>
						))}
					</ul>
					<p class="feed">
						<a href="/rss.xml">RSS feed</a>
					</p>
				</section>
			)
		}
	</main>
</Base>

<style>
	main {
		max-width: 56rem;
		margin: 0 auto;
		padding: 4rem 1.5rem 5rem;
	}
	header h1 {
		font-size: 1.75rem;
		font-weight: 600;
		color: var(--heading);
		letter-spacing: -0.01em;
	}
	header p {
		margin-top: 0.5rem;
		max-width: 40rem;
		color: var(--muted);
	}
	header nav {
		margin-top: 1rem;
		font-size: 0.9375rem;
	}
	section {
		margin-top: 3.5rem;
	}
	h2 {
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
	}
	.featured,
	.projects,
	.posts {
		list-style: none;
		display: grid;
		gap: 1rem;
	}
	.featured {
		margin-top: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
	}
	.more {
		margin-top: 2rem;
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.projects {
		margin-top: 0.75rem;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
	}
	.posts {
		margin-top: 1rem;
	}
	.post .date {
		font-size: 0.75rem;
		color: var(--muted);
	}
	.post h3 {
		margin-top: 0.25rem;
		font-size: 1.0625rem;
		font-weight: 600;
	}
	.post h3 a {
		color: var(--heading);
	}
	.post h3 a:hover {
		color: var(--link);
	}
	.standfirst {
		margin-top: 0.25rem;
		font-size: 0.9375rem;
	}
	.feed {
		margin-top: 1.5rem;
		font-size: 0.875rem;
	}
</style>
