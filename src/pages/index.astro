---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';

const description = 'Developer tools and other software Zachery Glass builds and maintains.';
---

<Base title="Zachery Glass" description={description}>
	<main>
		<header>
			<h1>Zachery Glass</h1>
			<p>Developer tools and other software I build and maintain.</p>
			<nav aria-label="Elsewhere">
				<a href="https://github.com/ZacheryGlass">GitHub</a>
			</nav>
		</header>

		<section aria-labelledby="projects">
			<h2 id="projects">Projects</h2>
			<ul class="projects">
				{
					projects.map((project) => (
						<li class="project">
							<p class="kind">{project.kind}</p>
							<h3>{project.name}</h3>
							<p class="description">{project.description}</p>
							<p class="links">
								{project.links.map((link) => (
									<a href={link.href}>{link.label}</a>
								))}
							</p>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</Base>

<style>
	main {
		max-width: 56rem;
		margin: 0 auto;
		padding: 4rem 1.5rem 5rem;
	}
	header h1 {
		font-size: 1.75rem;
		font-weight: 600;
		color: var(--heading);
		letter-spacing: -0.01em;
	}
	header p {
		margin-top: 0.5rem;
		color: var(--muted);
	}
	header nav {
		margin-top: 1rem;
		font-size: 0.9375rem;
	}
	section {
		margin-top: 3.5rem;
	}
	h2 {
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
	}
	.projects {
		list-style: none;
		margin-top: 1rem;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		gap: 1rem;
	}
	.project {
		display: flex;
		flex-direction: column;
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
	}
	.kind {
		font-size: 0.75rem;
		color: var(--muted);
	}
	h3 {
		margin-top: 0.25rem;
		font-size: 1.0625rem;
		font-weight: 600;
		color: var(--heading);
	}
	.description {
		margin-top: 0.5rem;
		font-size: 0.9375rem;
		flex: 1;
	}
	.links {
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.875rem;
	}
</style>
