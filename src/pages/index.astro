---
import Base from '../layouts/Base.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import PagePeel from '../components/PagePeel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { linkPeel, peelAttrs, projects } from '../data/projects';
import { latestRelease, repoCounts } from '../data/github';
import { description, person } from '../data/site';

const featured = await Promise.all(
	projects
		.filter((project) => project.featured)
		.map(async (project) => ({
			project,
			release: project.repo && project.stat === 'release' ? await latestRelease(project.repo) : undefined,
			counts: project.repo && project.stat === 'stars' ? await repoCounts(project.repo) : undefined,
		})),
);
const more = projects.filter((project) => !project.featured);

const links = [
	{ name: 'LinkedIn', href: 'https://www.linkedin.com/in/zacheryglass/' },
	{ name: 'GitHub', href: 'https://github.com/ZacheryGlass' },
];

const structuredData = { '@context': 'https://schema.org', ...person, description };
---

<Base title="Zachery Glass" description={description} structuredData={structuredData}>
	<main>
		<header>
			<h1>Zachery Glass</h1>
		</header>

		<section aria-labelledby="links">
			<h2 id="links">Links</h2>
			<ul class="links">
				{
					links.map((link) => (
						<li>
							<a href={link.href} {...peelAttrs(linkPeel(link.href))}>
								{link.name}
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section aria-labelledby="side-projects">
			<h2 id="side-projects">Side projects</h2>
			<ul class="featured">
				{featured.map((props) => <FeaturedProject {...props} />)}
			</ul>
		</section>

		<section aria-labelledby="more-projects">
			<h2 id="more-projects">More projects</h2>
			<ul class="projects">
				{more.map((project) => <ProjectCard project={project} />)}
			</ul>
		</section>
	</main>
	<PagePeel />
</Base>

<style>
	main {
		max-width: 73rem;
		margin: 0 auto;
		padding: 2.25rem clamp(1rem, 4vw, 1.5rem) 7rem;
	}
	h1 {
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--heading);
	}
	ul {
		list-style: none;
	}
	.featured {
		display: grid;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}
	section {
		margin-top: 4.125rem;
	}
	header + section {
		margin-top: clamp(2rem, 5vw, 3.5rem);
	}
	h2 {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--heading);
	}
	.projects {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
		gap: 1.25rem;
		margin-top: 1.1875rem;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin-top: 1.1875rem;
		font-weight: 500;
	}
</style>
