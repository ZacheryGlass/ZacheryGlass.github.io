---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../data/writing';
import { formatDate, person } from '../../data/site';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.date.toISOString().slice(0, 10),
	url: new URL(Astro.url.pathname, Astro.site).href,
	image: new URL('/og.png', Astro.site).href,
	author: person,
};
---

<Base
	title={`${post.data.title} · Zachery Glass`}
	description={post.data.description}
	type="article"
	structuredData={structuredData}
>
	<main>
		<article>
			<header>
				<p class="home"><a href="/">Zachery Glass</a></p>
				<h1>{post.data.title}</h1>
				<p class="standfirst">{post.data.description}</p>
				<p class="date">
					<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
					{post.data.draft && ' · Draft'}
				</p>
			</header>
			<div class="prose">
				<Content />
			</div>
		</article>
	</main>
</Base>

<style>
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 4rem 1.5rem 5rem;
	}
	.home {
		font-size: 0.9375rem;
	}
	h1 {
		margin-top: 2rem;
		font-size: 1.75rem;
		font-weight: 600;
		line-height: 1.25;
		color: var(--heading);
		letter-spacing: -0.01em;
	}
	.standfirst {
		margin-top: 0.75rem;
		font-size: 1.0625rem;
		color: var(--muted);
	}
	.date {
		margin-top: 0.75rem;
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.prose {
		margin-top: 2rem;
	}
	.prose :global(h2) {
		margin-top: 2.5rem;
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--heading);
	}
	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol),
	.prose :global(table),
	.prose :global(pre) {
		margin-top: 1rem;
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.25rem;
	}
	.prose :global(li + li) {
		margin-top: 0.5rem;
	}
	.prose :global(p a),
	.prose :global(li a) {
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.prose :global(code) {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.875em;
		padding: 0.1em 0.35em;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 4px;
	}
	.prose :global(pre) {
		padding: 1rem;
		overflow-x: auto;
		font-size: 0.875rem;
		line-height: 1.5;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
	}
	.prose :global(pre code) {
		padding: 0;
		font-size: inherit;
		background: none;
		border: 0;
	}
	.prose :global(.astro-code),
	.prose :global(.astro-code span) {
		color: var(--shiki-light);
	}
	@media (prefers-color-scheme: dark) {
		.prose :global(.astro-code),
		.prose :global(.astro-code span) {
			color: var(--shiki-dark);
		}
	}
	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
		font-variant-numeric: tabular-nums;
	}
	.prose :global(th),
	.prose :global(td) {
		padding: 0.5rem 0.75rem 0.5rem 0;
		text-align: left;
		border-bottom: 1px solid var(--border);
	}
	.prose :global(th) {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--muted);
	}
</style>
