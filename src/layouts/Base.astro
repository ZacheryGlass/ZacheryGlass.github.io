---
import { Font } from 'astro:assets';
import { bio } from '../data/site';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
	/** Share image; the site's card when omitted. */
	image?: { src: string; width: number; height: number; alt: string };
	/** Schema.org data for search engines, written as JSON-LD. */
	structuredData?: Record<string, unknown>;
}

const { title, description, type = 'website', structuredData } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = Astro.props.image ?? {
	src: new URL('/og.png', Astro.site).href,
	width: 1200,
	height: 630,
	alt: `Zachery Glass. ${bio}`,
};
// "<" is escaped so no string in the data can close the script element.
const jsonLd = structuredData && JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="Zachery Glass" href="/rss.xml" />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Zachery Glass" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image.src} />
		<meta property="og:image:width" content={String(image.width)} />
		<meta property="og:image:height" content={String(image.height)} />
		<meta property="og:image:alt" content={image.alt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="color-scheme" content="light dark" />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-display" preload />
		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #e9ecf3;
		--surface: #ffffff;
		--border: #d6dbe7;
		--text: #2a2f42;
		--heading: #0e1220;
		--muted: #4a5068;
		--link: #2b44c8;
		--link-hover: #1a2c8f;
		/* The dark card that leads the home page, dark in both color schemes. */
		--hero-bg: #0e1220;
		--hero-border: #0e1220;
		--hero-heading: #ffffff;
		--hero-text: #d3d7e6;
		--hero-muted: #a8aec4;
		--hero-link: #9db4ff;
		--hero-link-hover: #c9d6ff;
		--hero-button: #9ebdff;
		--hero-button-hover: #bcd1ff;
		--hero-button-text: #0a0f1f;
		--hero-row: #1c202d;
		--hero-bar: #3e414d;
		--hero-bar-faint: #262a36;
		/* The back of the page when it peels away. */
		--peel-crease: #c3cad9;
		--peel-light: #ffffff;
		--peel-paper: #f2f4f8;
		--peel-tip: #dde2ec;
		/* GitHub's page color, which follows the system color scheme for visitors not signed in. */
		--peel-github: #ffffff;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0a0d16;
			--surface: #131827;
			--border: #262c3e;
			--text: #c3c8d8;
			--heading: #f2f4fa;
			--muted: #8f95ab;
			--link: #9db4ff;
			--link-hover: #c9d6ff;
			--hero-bg: #161c2f;
			--hero-border: #2a3250;
			--hero-row: #20273b;
			--hero-bar: #434a62;
			--hero-bar-faint: #2b3248;
			--peel-crease: #070910;
			--peel-light: #2c344a;
			--peel-paper: #1d2335;
			--peel-tip: #151a28;
			--peel-github: #0d1117;
		}
	}
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}
	body {
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-sans);
		line-height: 1.55;
		-webkit-font-smoothing: antialiased;
	}
	a {
		color: var(--link);
		text-decoration: underline;
		text-decoration-thickness: 1.5px;
		text-underline-offset: 0.25em;
	}
	a:hover {
		color: var(--link-hover);
	}
	a:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 2px;
		border-radius: 2px;
	}
</style>
